PA_ENVIRONMENT=development
PA_DATABASE_URL=postgresql+psycopg://pa_app:local-app-only@127.0.0.1:55432/portfolio
PA_CONTROL_DATABASE_URL=postgresql+psycopg://pa_control:local-control-only@127.0.0.1:55432/portfolio
PA_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:local-owner-only@127.0.0.1:55432/portfolio
PA_CACHE_URL=redis://127.0.0.1:56379/0
PA_BROKER_URL=redis://127.0.0.1:56380/0
PA_APPLE_BUNDLE_ID=com.portfolioagent.ios
# Required for real StoreKit verification. Mount Apple roots from apple.com/certificateauthority.
# Separate sandbox deployment and database; never mix test and paying customers.
PA_STORE_ENVIRONMENT=Sandbox
# DeepSeek direct API. Never commit a real key; empty key disables external calls.
PA_DEEPSEEK_API_KEY=
PA_DEEPSEEK_MODEL=deepseek-flash
PA_AI_MAX_OUTPUT_TOKENS=2048
PA_AI_MAX_INPUT_CHARS=60000
# Contract permits third-party AI processing, including FX and derived values.
PA_AI_MARKET_DATA_PROVIDERS=[]
# Optional compatibility gateway; leave blank when using DeepSeek directly.
PA_AI_GATEWAY_URL=
PA_AI_GATEWAY_KEY=
PA_AI_PROVIDER_ID=deepseek
PA_AI_DISCLOSURE_VERSION=2
# Hashes of distinct operator tokens, never a mobile token. Generate with scripts/admin-token.py.
PA_ADMIN_CREDENTIALS={}
# Shared acquisition worker; run separately from the API. It also builds the searchable catalog.
PA_DATA_COLLECTION_ENABLED=false
# No per-symbol admin setup: the collector syncs AKShare A-share/ETF/HK lists.
PA_CATALOG_AUTO_DISCOVER=true
PA_CATALOG_LIVE_SEARCH_ENABLED=true
PA_CATALOG_SYNC_HOURS=24
# Deployment-level confirmation for displaying AKShare-sourced names and quotes.
# This is an operator decision, not a legal conclusion about the upstream data.
PA_AKSHARE_DISPLAY_CONFIRMED=true
PA_QUOTE_POLL_SECONDS=120
# A stale realtime/delayed quote may render as the latest close (status close_mark)
# while its market is closed, within this many days. 0 keeps "stale = missing".
PA_CLOSE_MARK_MAX_AGE_DAYS=4
# Polling cadence outside CN trading sessions (Mon-Fri 09:30-11:30 / 13:00-15:00 Asia/Shanghai).
PA_OFF_HOURS_QUOTE_POLL_SECONDS=600
PA_NEWS_POLL_SECONDS=300
PA_OFF_HOURS_NEWS_POLL_SECONDS=900
# PBOC central parity refresh cadence for CNY conversion of USD/HKD holdings.
PA_FX_POLL_SECONDS=21600
PA_DATA_MAX_INSTRUMENTS_PER_TICK=200
# Resident AKShare fetch workers; akshare is imported once inside each worker.
# Sequential collection needs one; the rest serve concurrent API refreshes.
PA_DATA_FETCH_WORKERS=2
# Global deployment budget: 100 Search requests/day = at most CNY 0.50/day at current API rates.
# Full traces can contain private financial and conversation data. Enable only
# with an updated disclosure and explicit consent; default is metadata only.
PA_AGENT_TRACE_CAPTURE_CONTENT=false
PA_SEARCH_DAILY_LIMIT=100
# Per-call output cap for the agent loop; DeepSeek reasoning tokens count against it.
PA_AGENT_MAX_OUTPUT_TOKENS=8192
# Scheduled report pipeline (plan A): deterministic facts are generated in batches
# without AI; AI summaries are separate batches for eligible users only, running
# with bounded in-task thread concurrency (one process serves several summaries).
PA_REPORT_BATCH_SIZE=500
PA_REPORT_AI_BATCH_SIZE=8
PA_REPORT_AI_CONCURRENCY=4
PA_REPORT_AI_BUDGET_SECONDS=480
PA_REPORT_JOB_LEASE_SECONDS=900
PA_REPORT_AI_ENABLED=true
# Deterministic per-user sampling for AI summaries: 1.0 = every user (legacy).
# At scale set ~0.1-0.2 so AI cost and worker time stay bounded.
PA_REPORT_AI_SAMPLE_RATIO=1.0
# Confirm applicable paid-app usage before listing a provider; never inferred from an MIT code licence.
PA_COMMERCIAL_DATA_PROVIDERS=[]
PA_NEWS_DISPLAY_PROVIDERS=[]
# Market-data sources the AI may receive. Display rights do NOT imply third-party
# AI processing rights; list only providers confirmed for AI processing.
PA_AI_MARKET_DATA_PROVIDERS=[]

# Phone login: opt in only after Aliyun services, sign and template are approved.
PA_AUTH_CACHE_URL=
PA_ALIYUN_SMS_ENABLED=false
PA_ALIYUN_CARRIER_ENABLED=false
PA_CARRIER_DAILY_LIMIT=1000
PA_ALIYUN_ACCESS_KEY_ID=
PA_ALIYUN_ACCESS_KEY_SECRET=
PA_ALIYUN_SMS_SIGN_NAME=
PA_ALIYUN_SMS_TEMPLATE_CODE=
# Generate a private random value >=32 characters; never commit it or put it in the app.
PA_PHONE_AUTH_PEPPER=
# Global SMS sends/day; per-phone 60s cooldown and 10/day also apply.
PA_SMS_DAILY_LIMIT=100

# Explicit Sandbox-only test identity 18000000000; never enable for a Production store.
PA_TEST_PHONE_LOGIN_ENABLED=false

# Dispatcher jobs materialised/sent per 2s cycle (keeps up with the 18:00 outbox burst).
PA_DISPATCH_BATCH_LIMIT=500
# Scheduled report delivery is staggered by ascending user id: every group of
# `PA_REPORT_DISPATCH_BATCH_USERS` ids starts `..._INTERVAL_SECONDS` later.
# Two daily sessions (A/HK 16:30 Asia/Shanghai, US 16:30 America/New_York) and a
# Saturday 09:00 Asia/Shanghai weekly are fixed in scheduler.py.
PA_REPORT_DISPATCH_BATCH_USERS=50
PA_REPORT_DISPATCH_BATCH_INTERVAL_SECONDS=15
